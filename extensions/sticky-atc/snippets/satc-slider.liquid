{% comment %}
  satc-slider — cart drawer markup, reward tiers JSON seed, recommendation seed.
  Rendered by satc-config. Loads drawer-only assets (sticky-atc-drawer.js/.css)
  only when the drawer is actually rendered.
{% endcomment %}
{% comment %}
  Cart drawer must render on every page (not only product pages) so the header
  cart icon can open Sticky ATC instead of navigating to /cart.
{% endcomment %}
{% if satc_enabled and satc_display_mode == 'slider' and satc_drawer_page_ok %}
  {% assign satc_rec_products = nil %}
  {% if satc_rec_on == true or satc_rec_on == 'true' %}
    {% if satc_rec_source == 'products' and satc_rec_products_cfg != blank %}
      {% comment %} Manual product list resolved via all_products {% endcomment %}
    {% else %}
      {% assign satc_rec_col = collections[satc_rec_collection] %}
      {% if satc_rec_col == blank %}
        {% assign satc_rec_col = collections.all %}
      {% endif %}
      {% if satc_rec_col != blank %}
        {% assign satc_rec_products = satc_rec_col.products %}
      {% endif %}
    {% endif %}
  {% endif %}

  <div
    class="satc-slider satc-slider--anim-{{ satc_drawer_anim }}{% if satc_theme_font == true or satc_theme_font == 'true' %} satc-slider--theme-font{% endif %}{% if satc_theme_text == true or satc_theme_text == 'true' %} satc-slider--theme-text{% endif %}"
    data-satc-slider
    data-satc-boot
    data-display-mode="slider"
    data-backdrop-blur="{% if satc_backdrop_blur == false or satc_backdrop_blur == 'false' %}false{% else %}true{% endif %}"
    data-backdrop-opacity="{% if satc_backdrop_opacity != blank %}{{ satc_backdrop_opacity }}{% else %}45{% endif %}"
    data-drawer-desktop="{% if satc_drawer_desktop == true or satc_drawer_desktop == 'true' %}true{% else %}false{% endif %}"
    data-drawer-mobile="{% if satc_drawer_mobile == true or satc_drawer_mobile == 'true' %}true{% else %}false{% endif %}"
    data-drawer-anim="{{ satc_drawer_anim | escape }}"
    data-after-add="{{ satc_after_add }}"
    data-i18n-cart-empty="{{ 'general.cart_empty' | t | escape }}"
    data-i18n-adding="{{ 'general.adding' | t | escape }}"
    data-i18n-added="{{ 'general.added' | t | escape }}"
    data-i18n-try-again="{{ 'general.try_again' | t | escape }}"
    data-i18n-add-failed="{{ 'general.add_failed' | t | escape }}"
    data-i18n-add-success="{{ 'general.add_success' | t | escape }}"
    data-i18n-unavailable="{{ 'general.unavailable' | t | escape }}"
    data-i18n-delete="{{ 'general.delete' | t | escape }}"
    data-i18n-remove="{{ 'general.remove' | t | escape }}"
    data-i18n-qty="{{ 'general.qty' | t: count: '__COUNT__' | escape }}"
    data-i18n-update-failed="{{ 'general.update_failed' | t | escape }}"
    data-i18n-decrease-qty="{{ 'general.decrease_quantity' | t | escape }}"
    data-i18n-increase-qty="{{ 'general.increase_quantity' | t | escape }}"
    data-drawer-title="{{ satc_drawer_title | escape }}"
    data-ship-enabled="{% if satc_ship_on == true or satc_ship_on == 'true' %}true{% else %}false{% endif %}"
    data-ship-threshold="{{ satc_ship_threshold }}"
    data-ship-text="{{ satc_ship_text | escape }}"
    data-ship-done="{{ satc_ship_done | escape }}"
    data-reward-enabled="{% if satc_reward_on == true or satc_reward_on == 'true' %}true{% else %}false{% endif %}"
    data-reward-empty="{% if satc_reward_empty == true or satc_reward_empty == 'true' %}true{% else %}false{% endif %}"
    data-reward-mode="{{ satc_reward_mode }}"
    data-reward-done="{{ satc_reward_done | escape }}"
    data-reward-anim="{{ satc_reward_anim | escape }}"
    data-reward-layout="{{ satc_reward_layout | escape }}"
    data-reward-style="{{ satc_reward_style | escape }}"
    data-reward-msg-pos="{{ satc_reward_msg_pos | escape }}"
    data-reward-show-icons="{% if satc_reward_show_icons == true or satc_reward_show_icons == 'true' %}true{% else %}false{% endif %}"
    data-reward-icon-style="{{ satc_reward_icon_style | escape }}"
    data-reward-icon-pos="{{ satc_reward_icon_pos | escape }}"
    data-rec-enabled="{% if satc_rec_on == true or satc_rec_on == 'true' %}true{% else %}false{% endif %}"
    data-rec-empty="{{ satc_rec_empty | escape }}"
    data-rec-header="{{ satc_rec_header | escape }}"
    data-rec-max="{{ satc_rec_max }}"
    data-rec-add="{{ satc_rec_add | escape }}"
    data-rec-shop-on="{% if satc_rec_shop_on == true or satc_rec_shop_on == 'true' %}true{% else %}false{% endif %}"
    data-rec-shop-text="{{ satc_rec_shop_text | escape }}"
    data-rec-shop-url="{{ satc_rec_shop_url | escape }}"
    data-rec-collection="{{ satc_rec_collection | escape }}"
    data-rec-with-items="{% if satc_rec_with_items == true or satc_rec_with_items == 'true' %}true{% else %}false{% endif %}"
    data-rec-hide-cart="{% if satc_rec_hide_cart == true or satc_rec_hide_cart == 'true' %}true{% else %}false{% endif %}"
    data-rec-source="{{ satc_rec_source | escape }}"
    data-rec-anim="{{ satc_rec_anim | escape }}"
    data-line-qty="{% if satc_line_qty == true or satc_line_qty == 'true' %}true{% else %}false{% endif %}"
    data-line-remove="{% if satc_line_remove == true or satc_line_remove == 'true' %}true{% else %}false{% endif %}"
    data-line-show-image="{% if satc_line_show_image == false or satc_line_show_image == 'false' %}false{% else %}true{% endif %}"
    data-line-show-title="{% if satc_line_show_title == false or satc_line_show_title == 'false' %}false{% else %}true{% endif %}"
    data-line-show-price="{% if satc_line_show_price == false or satc_line_show_price == 'false' %}false{% else %}true{% endif %}"
    data-line-show-variant="{% if satc_line_show_variant == false or satc_line_show_variant == 'false' %}false{% else %}true{% endif %}"
    data-line-image-size="{{ satc_line_image_size | default: 56 }}"
    data-line-qty-style="{{ satc_line_qty_style | default: 'stepper' | escape }}"
    data-line-qty-size="{{ satc_line_qty_size | default: 'medium' | escape }}"
    data-line-remove-style="{{ satc_line_remove_style | default: 'x' | escape }}"
    data-line-remove-size="{{ satc_line_remove_size | default: 'medium' | escape }}"
    data-checkout-text="{{ satc_drawer_checkout | escape }}"
    hidden
  >
    <script type="application/json" data-satc-feature-templates>
      {% if satc_feature_templates != blank %}{{ satc_feature_templates | json }}{% else %}{}{% endif %}
    </script>
    <script type="application/json" data-satc-custom-css>
      {{ satc_custom_css | default: '' | json }}
    </script>
    <style data-satc-custom-style></style>
    <script type="application/json" data-satc-reward-tiers>
      {% if satc_reward_tiers != blank %}{{ satc_reward_tiers | json }}{% else %}[]{% endif %}
    </script>
    <script type="application/json" data-satc-rec-seed>
      [
        {%- if satc_rec_source == 'products' and satc_rec_products_cfg != blank -%}
          {%- assign satc_rec_seed_count = 0 -%}
          {%- for item in satc_rec_products_cfg -%}
            {%- if satc_rec_seed_count < satc_rec_max -%}
              {%- assign handle = item.handle -%}
              {%- if handle != blank -%}
                {%- assign product = all_products[handle] -%}
                {%- if product != blank -%}
                  {%- assign v = product.selected_or_first_available_variant -%}
                  {%- if v.available -%}
                    {%- if satc_rec_seed_count > 0 -%},{%- endif -%}
                    {
                      "id": {{ product.id | json }},
                      "title": {{ product.title | json }},
                      "url": {{ product.url | json }},
                      "image": {% if product.featured_image %}{{ product.featured_image | image_url: width: 360 | json }}{% else %}""{% endif %},
                      "price": {{ v.price | json }},
                      "variantId": {{ v.id | json }},
                      "available": true
                    }
                    {%- assign satc_rec_seed_count = satc_rec_seed_count | plus: 1 -%}
                  {%- endif -%}
                {%- endif -%}
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
        {%- elsif satc_rec_products != blank -%}
          {%- assign satc_rec_seed_count = 0 -%}
          {%- for product in satc_rec_products -%}
            {%- if satc_rec_seed_count < satc_rec_max -%}
              {%- assign v = product.selected_or_first_available_variant -%}
              {%- if v.available -%}
                {%- if satc_rec_seed_count > 0 -%},{%- endif -%}
                {
                  "id": {{ product.id | json }},
                  "title": {{ product.title | json }},
                  "url": {{ product.url | json }},
                  "image": {% if product.featured_image %}{{ product.featured_image | image_url: width: 360 | json }}{% else %}""{% endif %},
                  "price": {{ v.price | json }},
                  "variantId": {{ v.id | json }},
                  "available": true
                }
                {%- assign satc_rec_seed_count = satc_rec_seed_count | plus: 1 -%}
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
      ]
    </script>
    <script type="application/json" data-satc-rec-products-cfg>
      {% if satc_rec_products_cfg != blank %}{{ satc_rec_products_cfg | json }}{% else %}[]{% endif %}
    </script>
    {%- assign satc_bd_op = satc_backdrop_opacity | default: 45 | plus: 0 -%}
    {%- if satc_bd_op > 1 -%}
      {%- comment -%} times 0.01 avoids Liquid integer divided_by truncating to 0 {%- endcomment -%}
      {%- assign satc_bd_op_css = satc_bd_op | times: 0.01 -%}
    {%- else -%}
      {%- assign satc_bd_op_css = satc_bd_op -%}
    {%- endif -%}
    {%- assign satc_blur_on = true -%}
    {%- if satc_backdrop_blur == false or satc_backdrop_blur == 'false' -%}
      {%- assign satc_blur_on = false -%}
    {%- endif -%}
    <div
      class="satc-slider__backdrop{% if satc_blur_on %} satc-slider__backdrop--blur{% endif %}"
      data-satc-slider-close
      data-satc-backdrop
      style="--satc-backdrop-opacity: {{ satc_bd_op_css }}; background: rgba(17, 17, 17, {{ satc_bd_op_css }}) !important;{% if satc_blur_on %} backdrop-filter: blur(16px) saturate(140%) !important; -webkit-backdrop-filter: blur(16px) saturate(140%) !important;{% endif %}"
    ></div>
    <aside
      class="satc-slider__panel satc-slider__panel--hdr-{{ satc_hdr_h }} satc-slider__panel--close-{{ satc_close_side }} satc-slider__panel--close-size-{{ satc_close_size }} satc-slider__panel--close-border-{{ satc_close_border }}{% if satc_hdr_border == 'thin' %} satc-slider__panel--hdr-border{% endif %}"
      role="dialog"
      aria-label="{{ satc_drawer_title | escape }}"
      style="
        --satc-bg: {{ satc_bg }};
        --satc-text: {% if satc_theme_text == true or satc_theme_text == 'true' %}rgb(var(--color-foreground, 18, 18, 18)){% else %}{{ satc_text }}{% endif %};
        --satc-font: {% if satc_theme_font == true or satc_theme_font == 'true' %}var(--font-body-family, var(--font-stack-body, inherit)){% else %}inherit{% endif %};
        --satc-btn-bg: {{ satc_btn_bg }};
        --satc-btn-text: {{ satc_btn_text }};
        --satc-accent: {{ satc_accent }};
        --satc-hdr-bg: {{ satc_hdr_bg }};
        --satc-title-align: {{ satc_title_align }};
        --satc-title-weight: {% if satc_title_weight == 'semibold' %}600{% elsif satc_title_weight == 'bold' %}700{% else %}400{% endif %};
        --satc-title-size: {{ satc_drawer_title_size }}px;
        --satc-close-bg: {{ satc_close_bg }};
        --satc-close-hover: {{ satc_close_hover }};
        --satc-close-color: {% if satc_theme_text == true or satc_theme_text == 'true' %}rgb(var(--color-foreground, 18, 18, 18)){% else %}{{ satc_close_color }}{% endif %};
        --satc-btn-radius: {{ satc_btn_radius }}px;
        --satc-line-image-size: {{ satc_line_image_size | default: 56 }}px;
        --satc-line-image-radius: {{ satc_line_image_radius | default: 8 }}px;
        --satc-line-title-size: {{ satc_line_title_size | default: 14 }}px;
        --satc-line-price-size: {{ satc_line_price_size | default: 14 }}px;
        --satc-line-gap: {{ satc_line_gap | default: 12 }}px;
        --satc-line-bg: {{ satc_line_bg | default: 'transparent' }};
        --satc-line-border: {{ satc_line_border | default: 'rgba(0,0,0,0.06)' }};
        --satc-line-qty-bg: {{ satc_line_qty_bg | default: 'transparent' }};
        {% if satc_line_text != blank %}--satc-line-text: {{ satc_line_text }};{% endif %}
        {% if satc_line_qty_text != blank %}--satc-line-qty-text: {{ satc_line_qty_text }};{% endif %}
        {% if satc_line_remove_color != blank %}--satc-line-remove: {{ satc_line_remove_color }};{% endif %}
      "
    >
      <div class="satc-slider__accent" aria-hidden="true"></div>
      <header class="satc-slider__header">
        <h2 class="satc-slider__title" data-satc-drawer-title>{{ satc_drawer_title }}</h2>
        <button type="button" class="satc-slider__close" data-satc-slider-close aria-label="{{ 'general.close' | t | escape }}">
          ×
        </button>
      </header>
      {% if satc_ann_on == true or satc_ann_on == 'true' %}
        {% if satc_ann_pos != 'after' %}
          <div
            class="satc-slider__announcement satc-slider__announcement--{{ satc_ann_height }}"
            data-satc-announcement
            data-ann-text="{{ satc_ann_text | escape }}"
            data-ann-timer="{{ satc_ann_timer | escape }}"
            style="background: {{ satc_ann_bg }}; color: {{ satc_ann_color }}; border-color: {{ satc_ann_border }}; font-size: {{ satc_ann_size }}px;"
          >
            <span data-satc-announcement-label>{{ satc_ann_text }}</span>
          </div>
        {% endif %}
      {% endif %}
      {% if satc_reward_on == true or satc_reward_on == 'true' or satc_ship_on == true or satc_ship_on == 'true' %}
        <div
          class="satc-slider__rewards satc-slider__rewards--anim-{{ satc_reward_anim }} satc-slider__rewards--layout-{{ satc_reward_layout }} satc-slider__rewards--fill-{{ satc_reward_style }} satc-slider__rewards--msg-{{ satc_reward_msg_pos }} satc-slider__rewards--icon-{{ satc_reward_icon_pos }} satc-slider__rewards--icon-style-{{ satc_reward_icon_style }}{% if satc_reward_show_icons == false or satc_reward_show_icons == 'false' %} satc-slider__rewards--icons-off{% endif %}"
          data-satc-rewards
          data-reward-anim="{{ satc_reward_anim | escape }}"
          data-reward-layout="{{ satc_reward_layout | escape }}"
          data-reward-style="{{ satc_reward_style | escape }}"
          data-reward-msg-pos="{{ satc_reward_msg_pos | escape }}"
          data-reward-show-icons="{% if satc_reward_show_icons == true or satc_reward_show_icons == 'true' %}true{% else %}false{% endif %}"
          data-reward-icon-style="{{ satc_reward_icon_style | escape }}"
          data-reward-icon-pos="{{ satc_reward_icon_pos | escape }}"
          style="--satc-reward-icon-size: {{ satc_reward_icon_size | default: 28 }}px; --satc-reward-icon: {{ satc_reward_icon | default: '#111111' }};{% if satc_reward_theme == true or satc_reward_theme == 'true' %}--satc-reward-bg: color-mix(in srgb, rgb(var(--color-button, var(--color-base-accent-1, 27, 57, 254))) 18%, #fff); --satc-reward-fg: rgb(var(--color-button, var(--color-base-accent-1, 179, 0, 159))); --satc-reward-text: rgb(var(--color-foreground, 17, 17, 17));{% else %}--satc-reward-bg: {{ satc_reward_bg }}; --satc-reward-fg: {{ satc_reward_fg }}; --satc-reward-text: {{ satc_reward_text }};{% endif %}"
        >
          <div class="satc-slider__rewards-rail">
            <div class="satc-slider__rewards-milestones" data-satc-reward-milestones></div>
            <div class="satc-slider__rewards-track">
              <span class="satc-slider__rewards-bar" data-satc-reward-bar></span>
            </div>
          </div>
          <p class="satc-slider__rewards-text" data-satc-reward-text></p>
        </div>
      {% endif %}
      <div class="satc-slider__body" data-satc-slider-items>
        <p class="satc-slider__empty">{{ 'general.cart_empty' | t }}</p>
      </div>
      {% if satc_ann_on == true or satc_ann_on == 'true' %}
        {% if satc_ann_pos == 'after' %}
          <div
            class="satc-slider__announcement satc-slider__announcement--{{ satc_ann_height }}"
            data-satc-announcement
            data-ann-text="{{ satc_ann_text | escape }}"
            data-ann-timer="{{ satc_ann_timer | escape }}"
            style="background: {{ satc_ann_bg }}; color: {{ satc_ann_color }}; border-color: {{ satc_ann_border }}; font-size: {{ satc_ann_size }}px;"
          >
            <span data-satc-announcement-label>{{ satc_ann_text }}</span>
          </div>
        {% endif %}
      {% endif %}
      <footer class="satc-slider__footer">
        {% if satc_disc_on == true or satc_disc_on == 'true' %}
          <form class="satc-slider__discount" data-satc-discount>
            <input
              type="text"
              name="discount"
              class="satc-slider__discount-input"
              placeholder="{{ satc_disc_ph | escape }}"
              autocomplete="off"
            >
            <button type="submit" class="satc-slider__discount-btn">{{ satc_disc_btn }}</button>
          </form>
        {% endif %}
        <div class="satc-slider__total">
          <span>{{ 'general.subtotal' | t }}</span>
          <strong data-satc-slider-total>—</strong>
        </div>
        <a class="satc-slider__checkout" href="/checkout" data-satc-slider-checkout>
          {{ satc_drawer_checkout }}
        </a>
        {% if satc_trust_on == true or satc_trust_on == 'true' %}
          <p class="satc-slider__trust">{{ satc_trust_text }}</p>
        {% endif %}
      </footer>
      <div
        class="satc-slider__toast"
        data-satc-toast
        hidden
        role="status"
        aria-live="polite"
      ></div>
    </aside>
  </div>

  {{ 'sticky-atc-drawer.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'sticky-atc-drawer.js' | asset_url }}" defer></script>
{% endif %}

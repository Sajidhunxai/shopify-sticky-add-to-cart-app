{% comment %}
  App block version — add via Theme Editor → Add block → Apps
  Uses the same satc-config + satc-bar as the app embed (bar only, no drawer).
  Assets load via the schema stylesheet/javascript below.
{% endcomment %}

{% render 'satc-config', block: block, render_mode: 'bar' %}

{% schema %}
{
  "name": "Sticky ATC Bar",
  "target": "section",
  "stylesheet": "sticky-atc.css",
  "javascript": "sticky-atc.js",
  "templates": ["product"],
  "settings": [
    {
      "type": "checkbox",
      "id": "enabled",
      "label": "Enable sticky bar",
      "default": true
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button text",
      "default": "Add to cart"
    },
    {
      "type": "checkbox",
      "id": "show_on_desktop",
      "label": "Show on desktop",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_title",
      "label": "Show product title",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "Show price",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_image",
      "label": "Show product image",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "hide_near_form",
      "label": "Hide when main Add to cart is visible",
      "default": true
    },
    {
      "type": "select",
      "id": "after_add",
      "label": "After adding to cart",
      "options": [
        { "value": "stay", "label": "Stay on page" },
        { "value": "cart", "label": "Go to cart" },
        { "value": "drawer", "label": "Open cart drawer (if theme supports it)" }
      ],
      "default": "stay"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Bar background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Button background",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text color",
      "default": "#ffffff"
    }
  ]
}
{% endschema %}

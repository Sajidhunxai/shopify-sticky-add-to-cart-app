{% if satc_accent == blank %}{% assign satc_accent = satc_btn_bg %}{% endif %}
{% if satc_drawer_title == blank or satc_drawer_title == 'Your cart' %}
  {% assign satc_drawer_title = 'general.your_cart' | t %}
{% endif %}
{% if satc_drawer_checkout == blank or satc_drawer_checkout == 'Checkout' %}
  {% assign satc_drawer_checkout = 'general.checkout' | t %}
{% endif %}
{% if satc_scroll_desktop == blank %}{% assign satc_scroll_desktop = 0 %}{% endif %}
{% if satc_bg_style == blank %}{% assign satc_bg_style = 'solid' %}{% endif %}
{% if satc_bg_opacity == blank %}{% assign satc_bg_opacity = 100 %}{% endif %}

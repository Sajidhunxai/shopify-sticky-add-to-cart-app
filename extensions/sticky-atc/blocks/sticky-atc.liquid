{% assign satc_rec_products = nil %}
{% if satc_rec_on == true or satc_rec_on == 'true' %}
  {% assign satc_rec_col = collections[satc_rec_collection] %}
  {% if satc_rec_col == blank %}
    {% assign satc_rec_col = collections.all %}
  {% endif %}
  {% if satc_rec_col != blank %}
    {% assign satc_rec_products = satc_rec_col.products %}
  {% endif %}
{% endif %}

{% assign satc_page_ok = false %}
{% case request.page_type %}
  {% when 'product' %}
    {% if satc_show_on_product %}{% assign satc_page_ok = true %}{% endif %}
  {% when 'collection' %}
    {% if satc_show_on_collection %}{% assign satc_page_ok = true %}{% endif %}
  {% when 'index' %}
    {% if satc_show_on_home %}{% assign satc_page_ok = true %}{% endif %}
  {% when 'search' %}
    {% if satc_show_on_search %}{% assign satc_page_ok = true %}{% endif %}
  {% else %}
    {% if satc_show_on_other %}{% assign satc_page_ok = true %}{% endif %}
{% endcase %}

{% if satc_enabled and satc_page_ok and product != blank %}
  {% assign product_image = product.featured_image | default: product.images.first %}

  <div
    id="satc-bar-{{ block.id }}"
    class="satc-bar satc-bar--{{ satc_display_mode }} satc-bar--layout-{{ satc_layout }} satc-bar--bg-{{ satc_bg_style }} satc-bar--pos-{{ satc_bar_position }} satc-bar--btn-{{ satc_button_size }} satc-bar--img-{{ satc_image_shape }}{% unless satc_show_shadow %} satc-bar--no-shadow{% endunless %}"
    data-satc-bar
    data-display-mode="{{ satc_display_mode }}"
    data-product-id="{{ product.id }}"
    data-variant-id="{{ product.selected_or_first_available_variant.id }}"
    data-after-add="{{ satc_after_add }}"
    data-hide-near-form="{{ satc_hide_near_form }}"
    data-desktop="{{ satc_show_desktop }}"
    data-mobile="{{ satc_show_mobile }}"
    data-show-after-scroll="{{ satc_scroll }}"
    data-show-after-scroll-desktop="{{ satc_scroll_desktop }}"
    data-i18n-adding="{{ 'general.adding' | t | escape }}"
    data-i18n-added="{{ 'general.added' | t | escape }}"
    data-i18n-try-again="{{ 'general.try_again' | t | escape }}"
    data-i18n-cart-empty="{{ 'general.cart_empty' | t | escape }}"
    style="
      --satc-bg: {{ satc_bg }};
      --satc-text: {{ satc_text }};
      --satc-border-width: {{ satc_border_width }}px;
      --satc-border-color: {{ satc_border_color }};
      --satc-bar-radius: {{ satc_bar_radius }}px;
      --satc-pad-y: {{ satc_pad_y }}px;
      --satc-pad-x: {{ satc_pad_x }}px;
      --satc-image-size: {{ satc_image_size }}px;
      --satc-image-radius: {{ satc_image_radius }}px;
      --satc-title-size: {{ satc_title_size }}px;
      --satc-price-size: {{ satc_price_size }}px;
      --satc-btn-radius: {{ satc_btn_radius }}px;
      --satc-btn-size: {{ satc_btn_size }}px;
      --satc-desk-max: {{ satc_desk_max }}px;
      --satc-desk-bottom: {{ satc_desk_bottom }}px;
      --satc-edge: {{ satc_desk_bottom }}px;
      --satc-btn-bg: {{ satc_btn_bg }};
      --satc-btn-text: {{ satc_btn_text }};
      --satc-gap: {{ satc_gap }}px;
      --satc-bg-opacity: {{ satc_bg_opacity | divided_by: 100.0 }};
      color: var(--satc-text);
    "
    {{ block.shopify_attributes }}
  >
    {% unless hide_branding == true or hide_branding == 'true' %}
      <span class="satc-bar__branding" style="color: var(--satc-text);">
        {{ 'general.powered_by' | t }}
      </span>
    {% endunless %}

    {% if satc_display_mode == 'quickbuy' %}
      <button
        type="button"
        class="satc-bar__quick-toggle"
        data-satc-quick-toggle
        aria-expanded="false"
        aria-label="{{ satc_button_label | escape }}"
        style="background: {{ satc_btn_bg }}; color: {{ satc_btn_text }};"
      >
        {{ satc_button_label }}
      </button>
      <div class="satc-bar__quick-panel" data-satc-quick-panel hidden>
    {% endif %}

    {% if satc_show_image == true or satc_show_image == 'true' %}
      {% if product_image %}
      <img
        class="satc-bar__media"
        src="{{ product_image | image_url: width: 240 }}"
        alt="{{ product.title | escape }}"
        width="{{ satc_image_size }}"
        height="{{ satc_image_size }}"
        loading="lazy"
      >
      {% endif %}
    {% endif %}

    {% if satc_show_title == true or satc_show_title == 'true' or satc_show_price == true or satc_show_price == 'true' %}
    <div class="satc-bar__info">
      {% if satc_show_title == true or satc_show_title == 'true' %}
        <p class="satc-bar__title" style="color: {{ satc_text }};">{{ product.title }}</p>
      {% endif %}
      {% if satc_show_price == true or satc_show_price == 'true' %}
        <p class="satc-bar__price" data-satc-price style="color: {{ satc_text }};">
          {{ product.selected_or_first_available_variant.price | money }}
        </p>
      {% endif %}
    </div>
    {% endif %}

    {% if satc_show_qty == true or satc_show_qty == 'true' %}
      <div class="satc-bar__qty" data-satc-qty>
        <button type="button" class="satc-bar__qty-btn" data-satc-qty-minus aria-label="{{ 'general.decrease_quantity' | t | escape }}">−</button>
        <input
          class="satc-bar__qty-input"
          data-satc-qty-input
          type="number"
          min="1"
          value="1"
          aria-label="{{ 'general.quantity' | t | escape }}"
        >
        <button type="button" class="satc-bar__qty-btn" data-satc-qty-plus aria-label="{{ 'general.increase_quantity' | t | escape }}">+</button>
      </div>
    {% endif %}

    <button
      type="button"
      class="satc-bar__button"
      data-satc-button
      style="
        background: {{ satc_btn_bg }};
        color: {{ satc_btn_text }};
      "
      {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}
    >
      {% if product.selected_or_first_available_variant.available %}
        {{ satc_button_label }}
      {% else %}
        {{ satc_sold_out }}
      {% endif %}
    </button>

    {% if satc_display_mode == 'quickbuy' %}
      </div>
    {% endif %}
  </div>
{% endif %}

{% comment %}
  Cart drawer must render on every page (not only product pages) so the header
  cart icon can open Sticky ATC instead of navigating to /cart.
{% endcomment %}
{% if satc_enabled and satc_display_mode == 'slider' %}
  <div
    class="satc-slider"
    data-satc-slider
    data-satc-boot
    data-display-mode="slider"
    data-after-add="{{ satc_after_add }}"
    data-i18n-cart-empty="{{ 'general.cart_empty' | t | escape }}"
    data-drawer-title="{{ satc_drawer_title | escape }}"
    data-ship-enabled="{% if satc_ship_on == true or satc_ship_on == 'true' %}true{% else %}false{% endif %}"
    data-ship-threshold="{{ satc_ship_threshold }}"
    data-ship-text="{{ satc_ship_text | escape }}"
    data-ship-done="{{ satc_ship_done | escape }}"
    data-reward-enabled="{% if satc_reward_on == true or satc_reward_on == 'true' %}true{% else %}false{% endif %}"
    data-reward-empty="{% if satc_reward_empty == true or satc_reward_empty == 'true' %}true{% else %}false{% endif %}"
    data-reward-mode="{{ satc_reward_mode }}"
    data-reward-done="{{ satc_reward_done | escape }}"
    data-reward-tiers="{% if satc_reward_tiers != blank %}{{ satc_reward_tiers | json | escape }}{% else %}[]{% endif %}"
    data-rec-enabled="{% if satc_rec_on == true or satc_rec_on == 'true' %}true{% else %}false{% endif %}"
    data-rec-empty="{{ satc_rec_empty | escape }}"
    data-rec-header="{{ satc_rec_header | escape }}"
    data-rec-max="{{ satc_rec_max }}"
    data-rec-add="{{ satc_rec_add | escape }}"
    data-rec-shop-on="{% if satc_rec_shop_on == true or satc_rec_shop_on == 'true' %}true{% else %}false{% endif %}"
    data-rec-shop-text="{{ satc_rec_shop_text | escape }}"
    data-rec-shop-url="{{ satc_rec_shop_url | escape }}"
    data-rec-collection="{{ satc_rec_collection | escape }}"
    data-line-qty="{% if satc_line_qty == true or satc_line_qty == 'true' %}true{% else %}false{% endif %}"
    data-line-remove="{% if satc_line_remove == true or satc_line_remove == 'true' %}true{% else %}false{% endif %}"
    data-checkout-text="{{ satc_drawer_checkout | escape }}"
    hidden
  >
    <script type="application/json" data-satc-rec-seed>
      [
        {%- if satc_rec_products != blank -%}
          {%- for product in satc_rec_products limit: satc_rec_max -%}
            {%- assign v = product.selected_or_first_available_variant -%}
            {
              "id": {{ product.id | json }},
              "title": {{ product.title | json }},
              "url": {{ product.url | json }},
              "image": {% if product.featured_image %}{{ product.featured_image | image_url: width: 360 | json }}{% else %}""{% endif %},
              "price": {{ v.price | json }},
              "variantId": {{ v.id | json }},
              "available": {{ v.available | json }}
            }{%- unless forloop.last -%},{%- endunless -%}
          {%- endfor -%}
        {%- endif -%}
      ]
    </script>
    <div
      class="satc-slider__backdrop{% if satc_backdrop_blur == true or satc_backdrop_blur == 'true' %} satc-slider__backdrop--blur{% endif %}"
      data-satc-slider-close
      style="--satc-backdrop-opacity: {{ satc_backdrop_opacity | divided_by: 100.0 }};"
    ></div>
    <aside
      class="satc-slider__panel satc-slider__panel--hdr-{{ satc_hdr_h }} satc-slider__panel--close-{{ satc_close_side }} satc-slider__panel--close-size-{{ satc_close_size }} satc-slider__panel--close-border-{{ satc_close_border }}{% if satc_hdr_border == 'thin' %} satc-slider__panel--hdr-border{% endif %}"
      role="dialog"
      aria-label="{{ satc_drawer_title | escape }}"
      style="
        --satc-bg: {{ satc_bg }};
        --satc-text: {{ satc_text }};
        --satc-btn-bg: {{ satc_btn_bg }};
        --satc-btn-text: {{ satc_btn_text }};
        --satc-accent: {{ satc_accent }};
        --satc-hdr-bg: {{ satc_hdr_bg }};
        --satc-title-align: {{ satc_title_align }};
        --satc-title-weight: {% if satc_title_weight == 'semibold' %}600{% elsif satc_title_weight == 'bold' %}700{% else %}400{% endif %};
        --satc-title-size: {{ satc_title_size }}px;
        --satc-close-bg: {{ satc_close_bg }};
        --satc-close-hover: {{ satc_close_hover }};
        --satc-close-color: {{ satc_close_color }};
        --satc-btn-radius: {{ satc_btn_radius }}px;
      "
    >
      <div class="satc-slider__accent" aria-hidden="true"></div>
      <header class="satc-slider__header">
        <h2 class="satc-slider__title" data-satc-drawer-title>{{ satc_drawer_title }}</h2>
        <button type="button" class="satc-slider__close" data-satc-slider-close aria-label="{{ 'general.close' | t | escape }}">
          ×
        </button>
      </header>
      {% if satc_ann_on == true or satc_ann_on == 'true' %}
        {% if satc_ann_pos != 'after' %}
          <div
            class="satc-slider__announcement satc-slider__announcement--{{ satc_ann_height }}"
            data-satc-announcement
            data-ann-text="{{ satc_ann_text | escape }}"
            data-ann-timer="{{ satc_ann_timer | escape }}"
            style="background: {{ satc_ann_bg }}; color: {{ satc_ann_color }}; border-color: {{ satc_ann_border }}; font-size: {{ satc_ann_size }}px;"
          >
            <span data-satc-announcement-label>{{ satc_ann_text }}</span>
          </div>
        {% endif %}
      {% endif %}
      {% if satc_reward_on == true or satc_reward_on == 'true' or satc_ship_on == true or satc_ship_on == 'true' %}
        <div
          class="satc-slider__rewards"
          data-satc-rewards
          style="--satc-reward-bg: {{ satc_reward_bg }}; --satc-reward-fg: {{ satc_reward_fg }}; --satc-reward-icon: {{ satc_reward_icon }};"
        >
          <div class="satc-slider__rewards-milestones" data-satc-reward-milestones></div>
          <div class="satc-slider__rewards-track">
            <span class="satc-slider__rewards-bar" data-satc-reward-bar></span>
          </div>
          <p class="satc-slider__rewards-text" data-satc-reward-text></p>
        </div>
      {% endif %}
      <div class="satc-slider__body" data-satc-slider-items>
        <p class="satc-slider__empty">{{ 'general.cart_empty' | t }}</p>
      </div>
      {% if satc_ann_on == true or satc_ann_on == 'true' %}
        {% if satc_ann_pos == 'after' %}
          <div
            class="satc-slider__announcement satc-slider__announcement--{{ satc_ann_height }}"
            data-satc-announcement
            data-ann-text="{{ satc_ann_text | escape }}"
            data-ann-timer="{{ satc_ann_timer | escape }}"
            style="background: {{ satc_ann_bg }}; color: {{ satc_ann_color }}; border-color: {{ satc_ann_border }}; font-size: {{ satc_ann_size }}px;"
          >
            <span data-satc-announcement-label>{{ satc_ann_text }}</span>
          </div>
        {% endif %}
      {% endif %}
      <footer class="satc-slider__footer">
        {% if satc_disc_on == true or satc_disc_on == 'true' %}
          <form class="satc-slider__discount" data-satc-discount>
            <input
              type="text"
              name="discount"
              class="satc-slider__discount-input"
              placeholder="{{ satc_disc_ph | escape }}"
              autocomplete="off"
            >
            <button type="submit" class="satc-slider__discount-btn">{{ satc_disc_btn }}</button>
          </form>
        {% endif %}
        <div class="satc-slider__total">
          <span>{{ 'general.subtotal' | t }}</span>
          <strong data-satc-slider-total>—</strong>
        </div>
        <a class="satc-slider__checkout" href="/checkout" data-satc-slider-checkout>
          {{ satc_drawer_checkout }}
        </a>
        {% if satc_trust_on == true or satc_trust_on == 'true' %}
          <p class="satc-slider__trust">{{ satc_trust_text }}</p>
        {% endif %}
      </footer>
    </aside>
  </div>
{% endif %}

{% schema %}
{
  "name": "t:name",
  "target": "body",
  "stylesheet": "sticky-atc.css",
  "javascript": "sticky-atc.js",
  "settings": [
    {
      "type": "paragraph",
      "content": "t:settings.paragraph_admin.content"
    },
    {
      "type": "checkbox",
      "id": "enabled",
      "label": "t:settings.enabled.label",
      "default": true
    },
    {
      "type": "select",
      "id": "display_mode",
      "label": "t:settings.display_mode.label",
      "options": [
        { "value": "bar", "label": "t:settings.display_mode.options.bar" },
        { "value": "slider", "label": "t:settings.display_mode.options.slider" },
        { "value": "quickbuy", "label": "t:settings.display_mode.options.quickbuy" }
      ],
      "default": "bar"
    },
    {
      "type": "header",
      "content": "t:settings.pages_header.content"
    },
    {
      "type": "checkbox",
      "id": "show_on_product",
      "label": "t:settings.show_on_product.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_on_collection",
      "label": "t:settings.show_on_collection.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_on_home",
      "label": "t:settings.show_on_home.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_on_search",
      "label": "t:settings.show_on_search.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_on_other",
      "label": "t:settings.show_on_other.label",
      "default": false
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:settings.button_label.label",
      "default": "Add to cart"
    },
    {
      "type": "checkbox",
      "id": "show_on_desktop",
      "label": "t:settings.show_on_desktop.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_title",
      "label": "t:settings.show_title.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "t:settings.show_price.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_image",
      "label": "t:settings.show_image.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "hide_near_form",
      "label": "t:settings.hide_near_form.label",
      "default": true
    },
    {
      "type": "select",
      "id": "after_add",
      "label": "t:settings.after_add.label",
      "options": [
        { "value": "stay", "label": "t:settings.after_add.options.stay" },
        { "value": "cart", "label": "t:settings.after_add.options.cart" },
        { "value": "drawer", "label": "t:settings.after_add.options.drawer" }
      ],
      "default": "stay"
    },
    {
      "type": "header",
      "content": "t:settings.colors_header.content"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color.label",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:settings.text_color.label",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "t:settings.button_background.label",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "t:settings.button_text_color.label",
      "default": "#ffffff"
    }
  ]
}
{% endschema %}

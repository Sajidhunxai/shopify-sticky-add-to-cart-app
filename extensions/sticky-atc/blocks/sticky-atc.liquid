{% if satc_reward_bg == blank %}{% assign satc_reward_bg = '#F0F2FF' %}{% endif %}
{% if satc_reward_fg == blank %}{% assign satc_reward_fg = '#B3009F' %}{% endif %}
{% if satc_reward_icon == blank %}{% assign satc_reward_icon = '#79be30' %}{% endif %}
{% if satc_reward_done == blank %}{% assign satc_reward_done = 'Free shipping unlocked!' %}{% endif %}

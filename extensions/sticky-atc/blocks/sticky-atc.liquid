{% comment %}
  Sticky Add to Cart — Theme App Extension (App Embed)
  Admin app settings (metafield) override Theme Editor defaults when present.
{% endcomment %}

{% assign cfg = app.metafields.sticky_atc.config.value %}
{% assign hide_branding = app.metafields.sticky_atc.hide_branding.value %}

{% if cfg != blank %}
  {% assign satc_enabled = cfg.enabled %}
  {% assign satc_display_mode = cfg.displayMode %}
  {% assign satc_show_image = cfg.showImage %}
  {% assign satc_show_title = cfg.showTitle %}
  {% assign satc_show_price = cfg.showPrice %}
  {% assign satc_show_desktop = cfg.showDesktop %}
  {% assign satc_show_mobile = cfg.showMobile %}
  {% assign satc_show_on_product = cfg.showOnProduct %}
  {% assign satc_show_on_collection = cfg.showOnCollection %}
  {% assign satc_show_on_home = cfg.showOnHome %}
  {% assign satc_show_on_search = cfg.showOnSearch %}
  {% assign satc_show_on_other = cfg.showOnOther %}
  {% assign satc_hide_near_form = cfg.hideNearForm %}
  {% assign satc_after_add = cfg.afterAdd %}
  {% assign satc_button_label = cfg.buttonText %}
  {% assign satc_sold_out = cfg.soldOutText %}
  {% assign satc_bg = cfg.backgroundColor %}
  {% assign satc_text = cfg.textColor %}
  {% assign satc_btn_bg = cfg.buttonBackground %}
  {% assign satc_btn_text = cfg.buttonTextColor %}
  {% assign satc_show_shadow = cfg.showShadow %}
  {% assign satc_border_width = cfg.borderWidth %}
  {% assign satc_bar_radius = cfg.barRadius %}
  {% assign satc_btn_radius = cfg.buttonRadius %}
  {% assign satc_pad_y = cfg.paddingY %}
  {% assign satc_pad_x = cfg.paddingX %}
  {% assign satc_image_size = cfg.imageSize %}
  {% assign satc_title_size = cfg.titleFontSize %}
  {% assign satc_price_size = cfg.priceFontSize %}
  {% assign satc_btn_size = cfg.buttonFontSize %}
  {% assign satc_desk_max = cfg.desktopMaxWidth %}
  {% assign satc_desk_bottom = cfg.desktopBottomOffset %}
  {% assign satc_scroll = cfg.showAfterScroll %}
  {% assign satc_scroll_desktop = cfg.showAfterScrollDesktop %}
  {% assign satc_bg_style = cfg.backgroundStyle %}
  {% assign satc_bg_opacity = cfg.backgroundOpacity %}
  {% assign satc_image_shape = cfg.imageShape %}
  {% assign satc_layout = cfg.layout %}
  {% assign satc_button_size = cfg.buttonSize %}
  {% assign satc_bar_position = cfg.barPosition %}
  {% assign satc_gap = cfg.contentGap %}
  {% assign satc_border_color = cfg.borderColor %}
  {% assign satc_image_radius = cfg.imageRadius %}
  {% assign satc_show_qty = cfg.showQuantity %}
{% else %}
  {% assign satc_enabled = block.settings.enabled %}
  {% assign satc_display_mode = block.settings.display_mode %}
  {% assign satc_show_image = block.settings.show_image %}
  {% assign satc_show_title = block.settings.show_title %}
  {% assign satc_show_price = block.settings.show_price %}
  {% assign satc_show_desktop = block.settings.show_on_desktop %}
  {% assign satc_show_mobile = true %}
  {% assign satc_show_on_product = block.settings.show_on_product %}
  {% assign satc_show_on_collection = block.settings.show_on_collection %}
  {% assign satc_show_on_home = block.settings.show_on_home %}
  {% assign satc_show_on_search = block.settings.show_on_search %}
  {% assign satc_show_on_other = block.settings.show_on_other %}
  {% assign satc_hide_near_form = block.settings.hide_near_form %}
  {% assign satc_after_add = block.settings.after_add %}
  {% assign satc_button_label = block.settings.button_label %}
  {% assign satc_sold_out = 'Sold out' %}
  {% assign satc_bg = block.settings.background_color %}
  {% assign satc_text = block.settings.text_color %}
  {% assign satc_btn_bg = block.settings.button_background %}
  {% assign satc_btn_text = block.settings.button_text_color %}
  {% assign satc_show_shadow = true %}
  {% assign satc_border_width = 0 %}
  {% assign satc_bar_radius = 14 %}
  {% assign satc_btn_radius = 8 %}
  {% assign satc_pad_y = 12 %}
  {% assign satc_pad_x = 16 %}
  {% assign satc_image_size = 64 %}
  {% assign satc_title_size = 14 %}
  {% assign satc_price_size = 13 %}
  {% assign satc_btn_size = 14 %}
  {% assign satc_desk_max = 720 %}
  {% assign satc_desk_bottom = 20 %}
  {% assign satc_scroll = 80 %}
  {% assign satc_scroll_desktop = 0 %}
  {% assign satc_bg_style = 'solid' %}
  {% assign satc_bg_opacity = 100 %}
  {% assign satc_image_shape = 'rounded' %}
  {% assign satc_layout = 'row' %}
  {% assign satc_button_size = 'normal' %}
  {% assign satc_bar_position = 'bottom' %}
  {% assign satc_gap = 12 %}
  {% assign satc_border_color = '#e5e7eb' %}
  {% assign satc_image_radius = 8 %}
  {% assign satc_show_qty = false %}
{% endif %}

{% if satc_display_mode == blank %}{% assign satc_display_mode = 'bar' %}{% endif %}
{% if satc_scroll_desktop == blank %}{% assign satc_scroll_desktop = 0 %}{% endif %}
{% if satc_bg_style == blank %}{% assign satc_bg_style = 'solid' %}{% endif %}
{% if satc_bg_opacity == blank %}{% assign satc_bg_opacity = 100 %}{% endif %}
{% if satc_image_shape == blank %}{% assign satc_image_shape = 'rounded' %}{% endif %}
{% if satc_layout == blank %}{% assign satc_layout = 'row' %}{% endif %}
{% if satc_button_size == blank %}{% assign satc_button_size = 'normal' %}{% endif %}
{% if satc_bar_position == blank %}{% assign satc_bar_position = 'bottom' %}{% endif %}
{% if satc_gap == blank %}{% assign satc_gap = 12 %}{% endif %}
{% if satc_border_color == blank %}{% assign satc_border_color = '#e5e7eb' %}{% endif %}
{% if satc_image_radius == blank %}{% assign satc_image_radius = 8 %}{% endif %}
{% if satc_show_qty == blank %}{% assign satc_show_qty = false %}{% endif %}
{% comment %} Defaults when older saved configs omit page flags {% endcomment %}
{% if satc_show_on_product == blank %}{% assign satc_show_on_product = true %}{% endif %}
{% if satc_show_on_collection == blank %}{% assign satc_show_on_collection = false %}{% endif %}
{% if satc_show_on_home == blank %}{% assign satc_show_on_home = false %}{% endif %}
{% if satc_show_on_search == blank %}{% assign satc_show_on_search = false %}{% endif %}
{% if satc_show_on_other == blank %}{% assign satc_show_on_other = false %}{% endif %}

{% assign satc_page_ok = false %}
{% case request.page_type %}
  {% when 'product' %}
    {% if satc_show_on_product %}{% assign satc_page_ok = true %}{% endif %}
  {% when 'collection' %}
    {% if satc_show_on_collection %}{% assign satc_page_ok = true %}{% endif %}
  {% when 'index' %}
    {% if satc_show_on_home %}{% assign satc_page_ok = true %}{% endif %}
  {% when 'search' %}
    {% if satc_show_on_search %}{% assign satc_page_ok = true %}{% endif %}
  {% else %}
    {% if satc_show_on_other %}{% assign satc_page_ok = true %}{% endif %}
{% endcase %}

{% if satc_enabled and satc_page_ok and product != blank %}
  {% assign product_image = product.featured_image | default: product.images.first %}

  <div
    id="satc-bar-{{ block.id }}"
    class="satc-bar satc-bar--{{ satc_display_mode }} satc-bar--layout-{{ satc_layout }} satc-bar--bg-{{ satc_bg_style }} satc-bar--pos-{{ satc_bar_position }} satc-bar--btn-{{ satc_button_size }} satc-bar--img-{{ satc_image_shape }}{% unless satc_show_shadow %} satc-bar--no-shadow{% endunless %}"
    data-satc-bar
    data-display-mode="{{ satc_display_mode }}"
    data-product-id="{{ product.id }}"
    data-variant-id="{{ product.selected_or_first_available_variant.id }}"
    data-after-add="{{ satc_after_add }}"
    data-hide-near-form="{{ satc_hide_near_form }}"
    data-desktop="{{ satc_show_desktop }}"
    data-mobile="{{ satc_show_mobile }}"
    data-show-after-scroll="{{ satc_scroll }}"
    data-show-after-scroll-desktop="{{ satc_scroll_desktop }}"
    style="
      --satc-bg: {{ satc_bg }};
      --satc-text: {{ satc_text }};
      --satc-border-width: {{ satc_border_width }}px;
      --satc-border-color: {{ satc_border_color }};
      --satc-bar-radius: {{ satc_bar_radius }}px;
      --satc-pad-y: {{ satc_pad_y }}px;
      --satc-pad-x: {{ satc_pad_x }}px;
      --satc-image-size: {{ satc_image_size }}px;
      --satc-image-radius: {{ satc_image_radius }}px;
      --satc-title-size: {{ satc_title_size }}px;
      --satc-price-size: {{ satc_price_size }}px;
      --satc-btn-radius: {{ satc_btn_radius }}px;
      --satc-btn-size: {{ satc_btn_size }}px;
      --satc-desk-max: {{ satc_desk_max }}px;
      --satc-desk-bottom: {{ satc_desk_bottom }}px;
      --satc-btn-bg: {{ satc_btn_bg }};
      --satc-btn-text: {{ satc_btn_text }};
      --satc-gap: {{ satc_gap }}px;
      --satc-bg-opacity: {{ satc_bg_opacity | divided_by: 100.0 }};
      color: var(--satc-text);
    "
    {{ block.shopify_attributes }}
  >
    {% unless hide_branding == true or hide_branding == 'true' %}
      <span class="satc-bar__branding" style="color: var(--satc-text);">
        Powered by Sticky ATC
      </span>
    {% endunless %}

    {% if satc_display_mode == 'quickbuy' %}
      <button
        type="button"
        class="satc-bar__quick-toggle"
        data-satc-quick-toggle
        aria-expanded="false"
        aria-label="{{ satc_button_label | escape }}"
        style="background: {{ satc_btn_bg }}; color: {{ satc_btn_text }};"
      >
        {{ satc_button_label }}
      </button>
      <div class="satc-bar__quick-panel" data-satc-quick-panel hidden>
    {% endif %}

    {% if satc_show_image and product_image %}
      <img
        class="satc-bar__media"
        src="{{ product_image | image_url: width: 240 }}"
        alt="{{ product.title | escape }}"
        width="{{ satc_image_size }}"
        height="{{ satc_image_size }}"
        loading="lazy"
      >
    {% endif %}

    <div class="satc-bar__info">
      {% if satc_show_title %}
        <p class="satc-bar__title">{{ product.title }}</p>
      {% endif %}
      {% if satc_show_price %}
        <p class="satc-bar__price" data-satc-price>
          {{ product.selected_or_first_available_variant.price | money }}
        </p>
      {% endif %}
    </div>

    {% if satc_show_qty %}
      <div class="satc-bar__qty" data-satc-qty>
        <button type="button" class="satc-bar__qty-btn" data-satc-qty-minus aria-label="Decrease quantity">−</button>
        <input
          class="satc-bar__qty-input"
          data-satc-qty-input
          type="number"
          min="1"
          value="1"
          aria-label="Quantity"
        >
        <button type="button" class="satc-bar__qty-btn" data-satc-qty-plus aria-label="Increase quantity">+</button>
      </div>
    {% endif %}

    <button
      type="button"
      class="satc-bar__button"
      data-satc-button
      style="
        background: {{ satc_btn_bg }};
        color: {{ satc_btn_text }};
      "
      {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}
    >
      {% if product.selected_or_first_available_variant.available %}
        {{ satc_button_label }}
      {% else %}
        {{ satc_sold_out }}
      {% endif %}
    </button>

    {% if satc_display_mode == 'quickbuy' %}
      </div>
    {% endif %}
  </div>

  {% if satc_display_mode == 'slider' %}
    <div class="satc-slider" data-satc-slider hidden>
      <div class="satc-slider__backdrop" data-satc-slider-close></div>
      <aside
        class="satc-slider__panel"
        role="dialog"
        aria-label="Cart"
        style="--satc-bg: {{ satc_bg }}; --satc-text: {{ satc_text }}; --satc-btn-bg: {{ satc_btn_bg }}; --satc-btn-text: {{ satc_btn_text }};"
      >
        <header class="satc-slider__header">
          <h2 class="satc-slider__title">Your cart</h2>
          <button type="button" class="satc-slider__close" data-satc-slider-close aria-label="Close">
            ×
          </button>
        </header>
        <div class="satc-slider__body" data-satc-slider-items>
          <p class="satc-slider__empty">Your cart is empty</p>
        </div>
        <footer class="satc-slider__footer">
          <div class="satc-slider__total">
            <span>Subtotal</span>
            <strong data-satc-slider-total>—</strong>
          </div>
          <a class="satc-slider__checkout" href="{{ routes.cart_url }}" data-satc-slider-checkout>
            Checkout
          </a>
        </footer>
      </aside>
    </div>
  {% endif %}
{% endif %}

{% schema %}
{
  "name": "Sticky Add to Cart",
  "target": "body",
  "stylesheet": "sticky-atc.css",
  "javascript": "sticky-atc.js",
  "settings": [
    {
      "type": "paragraph",
      "content": "Prefer the app admin for content and style. These Theme Editor fields are used only until you save settings in the app."
    },
    {
      "type": "checkbox",
      "id": "enabled",
      "label": "Enable sticky bar",
      "default": true
    },
    {
      "type": "select",
      "id": "display_mode",
      "label": "Display style",
      "options": [
        { "value": "bar", "label": "Sticky Add to Cart Bar" },
        { "value": "slider", "label": "Sticky Cart with Cart Slider" },
        { "value": "quickbuy", "label": "Quick Buy Cart" }
      ],
      "default": "bar"
    },
    {
      "type": "header",
      "content": "Show on pages"
    },
    {
      "type": "checkbox",
      "id": "show_on_product",
      "label": "Product pages",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_on_collection",
      "label": "Collection pages",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_on_home",
      "label": "Homepage",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_on_search",
      "label": "Search results",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_on_other",
      "label": "Other pages",
      "default": false
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button text",
      "default": "Add to cart"
    },
    {
      "type": "checkbox",
      "id": "show_on_desktop",
      "label": "Show on desktop",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_title",
      "label": "Show product title",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "Show price",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_image",
      "label": "Show product image",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "hide_near_form",
      "label": "Hide when main Add to cart is visible",
      "default": true
    },
    {
      "type": "select",
      "id": "after_add",
      "label": "After adding to cart",
      "options": [
        { "value": "stay", "label": "Stay on page" },
        { "value": "cart", "label": "Go to cart" },
        { "value": "drawer", "label": "Open cart drawer (if theme supports it)" }
      ],
      "default": "stay"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Bar background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Button background",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text color",
      "default": "#ffffff"
    }
  ]
}
{% endschema %}
